rules_version = '2';

// Firestore security rules for Clean Notes.
//
// Goals:
//   * Every note is owned by exactly one Firebase Auth user (uid).
//   * A user can only list/read/update/delete notes they own.
//   * On create, the new document's `ownerId` must equal the caller's uid,
//     so a client cannot write a doc owned by someone else.
//   * `createdAt` / `ownerId` are immutable on existing docs.
//
// Anonymous authentication is enabled in the Firebase Console, so each
// device gets a stable uid without a real sign-in UI.

service cloud.firestore {
  match /databases/{database}/documents {

    match /notes/{noteId} {

      // ---- Helpers -----------------------------------------------------

      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner() {
        return isSignedIn() && resource.data.ownerId == request.auth.uid;
      }

      function incomingOwnerMatchesCaller() {
        return request.resource.data.ownerId == request.auth.uid;
      }

      // ---- Reads -------------------------------------------------------

      // get / list: only see your own notes.
      allow get: if isOwner();
      allow list: if isSignedIn();

      // ---- Writes ------------------------------------------------------

      // Create: must be signed in, ownerId must equal the caller's uid,
      // and the required fields must be present.
      allow create: if isSignedIn()
        && incomingOwnerMatchesCaller()
        && request.resource.data.keys().hasAll([
             'ownerId', 'title', 'description', 'createdAt', 'updatedAt',
           ])
        && request.resource.data.title is string
        && request.resource.data.description is string;

      // Update: caller must already own the doc, and cannot reassign
      // ownership or rewrite createdAt.
      allow update: if isOwner()
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.createdAt == resource.data.createdAt;

      // Delete: owner only.
      allow delete: if isOwner();
    }

    // Everything else is denied by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}